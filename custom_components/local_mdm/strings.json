{
  "config": {
    "step": {
      "user": {
        "title": "Connect to a tablet",
        "description": "Open the Local MDM app on the tablet. It shows its address and a pairing token once it is Device Owner.",
        "data": {
          "host": "Tablet address",
          "port": "Port",
          "token": "Pairing token"
        }
      },
      "reauth_confirm": {
        "title": "Update the pairing token",
        "description": "The tablet at {host} rejected the stored token. Enter the token shown in the Local MDM app.",
        "data": {
          "token": "Pairing token"
        }
      }
    },
    "error": {
      "cannot_connect": "The tablet did not answer. Check the address, the port, and that the Local MDM app is running.",
      "invalid_auth": "The tablet rejected the token."
    },
    "abort": {
      "already_configured": "This tablet is already configured.",
      "reauth_successful": "The token was updated.",
      "wrong_device": "The token belongs to a different tablet than this entry."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling fallback",
        "data": {
          "scan_interval": "Poll interval"
        },
        "data_description": {
          "scan_interval": "The tablet pushes every change immediately; this poll only catches a missed push."
        }
      }
    }
