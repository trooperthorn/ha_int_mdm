  "services": {
    "install_package": {
      "name": "Install package",
      "description": "Download an APK and install it silently on the tablet. Android only accepts an update signed with the same key as the installed app.",
      "fields": {
        "device_id": {
          "name": "Tablet",
          "description": "The Local MDM tablet to install on."
        },
        "url": {
          "name": "APK URL",
          "description": "HTTP or HTTPS address of the APK, for example a GitHub release asset."
        },
        "sha256": {
          "name": "SHA-256",
          "description": "Optional digest of the APK; the install is refused when it does not match."
        }
      }
    },
    "configure_wifi": {
      "name": "Configure Wi-Fi",
      "description": "Hand a Wi-Fi network to the tablet. Android stores it; the DPC and Home Assistant keep no copy of the password. The tablet's own Wi-Fi settings stay unlocked.",
      "fields": {
        "device_id": {
          "name": "Tablet",
          "description": "The Local MDM tablet to configure."
        },
        "ssid": {
          "name": "Network name",
          "description": "The SSID, 1 to 32 characters."
        },
        "password": {
          "name": "Password",
          "description": "WPA2 or WPA3 personal passphrase, 8 to 63 characters. Leave empty for an open network."
        },
        "hidden": {
          "name": "Hidden network",
          "description": "The network does not broadcast its SSID."
        }
      }
    },
    "apply_policy": {
      "name": "Apply policy",
      "description": "Push a complete policy document to a tablet, the way a security profile is applied. Keys left out fall back to their least restrictive value; the network guard still refuses anything that could sever Wi-Fi or adb.",
      "fields": {
        "device_id": {
          "name": "Tablet",
          "description": "The Local MDM tablet to apply the policy to."
        },
        "policy": {
          "name": "Policy",
          "description": "The policy document: the switch keys, kiosk_packages, app_mode and allowed_packages."
        }
      }
    }
  }
