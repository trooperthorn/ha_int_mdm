<?xml version="1.0" encoding="utf-8"?>
<!-- Lock splash shown for a moment before the kiosk package is launched. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020803"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="220dp"
        android:layout_height="256dp"
        android:contentDescription="@string/mdm_managed"
        android:src="@drawable/shield_lock" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:shadowColor="#B333FF66"
        android:shadowRadius="14"
        android:text="@string/mdm_managed"
        android:textColor="#33FF66"
        android:textSize="52sp" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="280dp"
        android:layout_height="6dp"
        android:layout_marginTop="36dp"
        android:indeterminate="true"
        android:indeterminateTint="#33FF66"
        android:progressBackgroundTint="#062A10" />
</LinearLayout>
